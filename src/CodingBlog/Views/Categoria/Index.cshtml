@model PagedResult<CategoriaViewModel>

<vc:carrossel></vc:carrossel>

<div class="container  pt-3">
   <nav aria-label=" breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active text-white" aria-current="page">Lista de categorias</li>
        </ol>
    </nav>

    @if (Model == null || Model.Items.Count == 0)
    {
        <div class="alert alert-info">Nenhuma categoria cadastrada</div>
    }
    else
    {
        <ul class="list-group ">
            @foreach (var item in Model.Items)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <a asp-action="PorCategoria" asp-controller="Post" asp-route-id="@item.Id">
                        @item.Nome
                    </a>
                    <span class="badge bg-primary rounded-pill float-end">@item.QtdPosts</span>
                </li>
            }
        </ul>
        <partial name="~/Views/Shared/_Pagination.cshtml" model="Model" />
    }
</div>

@section scripts{
    <script>
        $(function(){
            $(".nav-link").last().addClass("active");
        });
    </script>
}
