@model CodingBlog.Models.Admin.AdminPostFormViewModel
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Editar post" : "Novo post";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Escreva em Markdown, organize as tags e publique com imagem destacada.</p>
    </div>
    <a class="btn btn-outline-primary" asp-action="Index">Voltar</a>
</div>

<form method="post" enctype="multipart/form-data" class="admin-post-editor">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="Imagem" type="hidden" />

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card h-100">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">Título</label>
                        <input asp-for="Titulo" class="form-control" maxlength="180" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descritivo" class="form-label">Conteúdo em Markdown</label>
                        <textarea asp-for="Descritivo" class="form-control admin-markdown-input" rows="18"></textarea>
                        <span asp-validation-for="Descritivo" class="text-danger"></span>
                    </div>

                    <div class="admin-preview-shell">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h2 class="h6 mb-0">Preview</h2>
                            <span class="text-muted small">Atualizado localmente</span>
                        </div>
                        <div id="markdown-preview" class="admin-markdown-preview"></div>
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <section class="card mb-4">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CategoriaId" class="form-label">Categoria</label>
                        <select asp-for="CategoriaId" class="form-select">
                            <option value="">Selecione</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Nome</option>
                            }
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tags" class="form-label">Tags</label>
                        <input asp-for="Tags" class="form-control" placeholder="C#, .NET, arquitetura" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUpload" class="form-label">Imagem destacada</label>
                        <input asp-for="ImageUpload" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" />
                        <span asp-validation-for="ImageUpload" class="text-danger"></span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Imagem))
                    {
                        <div class="admin-image-preview mb-3">
                            <img src="~/img/artigos/@Model.Imagem" alt="Imagem atual do post" />
                        </div>
                    }

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Salvar post</button>
                        <a class="btn btn-outline-primary" asp-action="Index">Cancelar</a>
                    </div>
                </div>
            </section>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        const editor = document.querySelector('.admin-markdown-input');
        const preview = document.getElementById('markdown-preview');

        function renderPreview(markdown) {
            preview.innerHTML = renderMarkdown(markdown || '');
        }

        editor.addEventListener('input', function () {
            renderPreview(editor.value);
        });

        renderPreview(editor.value);
    </script>
}
