@{
    ViewData["Title"] = "Posts";
    var categories = ViewBag.Categories as IReadOnlyCollection<CodingBlog.Models.Admin.CategoryOptionViewModel> ?? [];
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Posts</h1>
        <p class="text-muted mb-0">Administre conteúdo, imagem destacada e categorização.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Novo post</a>
</div>

<section class="admin-panel">
    <div class="admin-toolbar admin-toolbar-wide">
        <input id="post-search" class="form-control" type="search" placeholder="Buscar por título, conteúdo ou tag" />
        <select id="post-category-filter" class="form-select">
            <option value="">Todas as categorias</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Nome</option>
            }
        </select>
        <select id="post-page-size" class="form-select">
            <option value="10">10 por página</option>
            <option value="25">25 por página</option>
            <option value="50">50 por página</option>
        </select>
    </div>

    <div class="table-responsive">
        <table class="table admin-table" id="posts-table">
            <thead>
                <tr>
                    <th data-sort="titulo">Título</th>
                    <th data-sort="categoria">Categoria</th>
                    <th data-sort="tags">Tags</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>

    <div class="admin-table-footer">
        <div id="posts-summary" class="text-muted small"></div>
        <div id="posts-pagination" class="admin-pagination"></div>
    </div>
</section>

<form id="delete-post-token" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
<script>
    const deleteToken = document.querySelector('#delete-post-token input[name="__RequestVerificationToken"]').value;
    const editPostUrlTemplate = '@Url.Action("Edit", "Posts", new { area = "Admin", id = "__id__" })';
    const deletePostUrlTemplate = '@Url.Action("Delete", "Posts", new { area = "Admin", id = "__id__" })';

    createAdminGrid({
        endpoint: '@Url.Action("Grid", "Posts", new { area = "Admin" })',
        searchInput: '#post-search',
        pageSizeInput: '#post-page-size',
        extraParams: function () {
            return {
                categoryId: $('#post-category-filter').val()
            };
        },
        refreshTriggers: ['#post-category-filter'],
        tableSelector: '#posts-table',
        tbodyRenderer: function (items) {
            if (!items.length) {
                return '<tr><td colspan="4" class="text-center text-muted py-4">Nenhum post encontrado.</td></tr>';
            }

            return items.map(function (item) {
                return `
                    <tr>
                        <td>
                            <div class="fw-semibold">${escapeHtml(item.titulo)}</div>
                            <div class="admin-truncate text-muted small">${escapeHtml(item.descritivo || '')}</div>
                        </td>
                        <td>${escapeHtml(item.categoria)}</td>
                        <td>${escapeHtml(item.tags || '')}</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" href="${editPostUrlTemplate.replace('__id__', item.id)}">Editar</a>
                                <form method="post" action="${deletePostUrlTemplate.replace('__id__', item.id)}" class="d-inline">
                                    <input name="__RequestVerificationToken" type="hidden" value="${deleteToken}" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>`;
            }).join('');
        },
        summarySelector: '#posts-summary',
        paginationSelector: '#posts-pagination',
        defaultSortBy: 'id',
        defaultSortDirection: 'desc'
    });
</script>
}
